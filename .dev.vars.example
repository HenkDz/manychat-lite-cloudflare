# Deploy to Cloudflare discovers these five required secrets.
# No shared passwords or credentials are supplied: enter your own values.
# Descriptions in package.json explain where each value comes from.
# For a local demo with fake credentials, use .dev.vars.local.example instead.
WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
ADMIN_TOKEN=
